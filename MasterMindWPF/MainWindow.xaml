<Window x:Class="MasterMindWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MasterMindWPF" xmlns:UserControl="clr-namespace:MasterMindWPF.Views"
        mc:Ignorable="d"
        Title="Master Mind" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="MasterMind" FontSize="72"  Grid.Row="0" TextAlignment="Center" VerticalAlignment="Top"/>
        <UserControl:BoardView Grid.Row="1" DataContext="{Binding BoardViewModel}"/>
    </Grid>
</Window>
